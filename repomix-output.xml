                    <td className="py-5 px-6">
                      <span className="font-mono text-xs font-bold text-slate-500 bg-slate-100 px-2 py-1 rounded border border-slate-200">
                        {op.referencia_interna}
                      </span>
                    </td>
                    <td className="py-5 px-6 space-y-1">
                      {getEstadoBadge(op.estado_sri)}
                      {op.secuencial_tributario && (
                        <p className="text-xs font-mono font-bold text-slate-600 mt-1">
                          {op.secuencial_tributario}
                        </p>
                      )}
                    </td>
                    <td className="py-5 px-6 font-black text-slate-900">
                      ${Number(op.monto).toFixed(2)}
                    </td>
                    <td className="py-5 px-6 text-right space-x-2">
                      {op.estado_sri === "pendiente_emision" && (
                        <button
                          onClick={() =>
                            emitirFactura(
                              op.pago_id,
                              op.paciente_nombre,
                              op.monto,
                            )
                          }
                          disabled={procesando === op.pago_id}
                          className="bg-purple-700 text-white hover:bg-purple-800 px-4 py-2 rounded-xl text-sm font-black transition-colors shadow-sm disabled:opacity-50"
                        >
                          {procesando === op.pago_id
                            ? "Procesando..."
                            : "Emitir factura"}
                        </button>
                      )}
                      {op.estado_sri === "autorizada" && (
                        <div className="flex justify-end gap-2">
                          <button className="bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors shadow-sm">
                            Ver factura
                          </button>
                          <button className="bg-purple-50 border border-purple-100 text-purple-600 hover:bg-purple-100 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors shadow-sm">
                            Descargar XML
                          </button>
                        </div>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/app/dashboard-secretaria/gestion-citas/page.tsx">
"use client";

import { useEffect, useState } from "react";
import { supabase } from "../../../../lib/supabase";

interface Cita {
  id: string;
  fecha: string;
  hora: string;
  motivo: string;
  estado: string;
}

export default function GestionCitasSecretariaPage() {
  const [citas, setCitas] = useState<Cita[]>([]);
  const [cargando, setCargando] = useState(true);
  const [refrescar, setRefrescar] = useState(0);

  useEffect(() => {
    const cargarTodasLasCitas = async () => {
      setCargando(true);
      try {
        // La secretaria ve TODAS las citas del sistema
        const { data, error } = await supabase
          .from("citas")
          .select("*")
          .order("fecha", { ascending: true })
          .order("hora", { ascending: true });

        if (error) throw error;
        setCitas(data || []);
      } catch (error) {
        console.error("Error al cargar la gestión de citas:", error);
      } finally {
        setCargando(false);
      }
    };

    cargarTodasLasCitas();
  }, [refrescar]);

  const cambiarEstadoCita = async (id: string, nuevoEstado: string) => {
    try {
      const { error } = await supabase
        .from("citas")
        .update({ estado: nuevoEstado })
        .eq("id", id);

      if (error) throw error;

      // Recargamos la tabla visualmente
      setRefrescar((prev) => prev + 1);
    } catch (error) {
      alert("Error al actualizar el estado de la cita en el sistema.");
      console.error(error);
    }
  };

  return (
    <div className="w-full p-8 font-sans">
      <div className="mb-8 flex justify-between items-center">
        <div>
          <h1 className="text-3xl font-bold text-gray-800">
            Gestión Global de Citas
          </h1>
          <p className="text-gray-500 mt-1">
            Coordina, confirma y cancela las solicitudes de toda la clínica.
          </p>
        </div>
      </div>

      <div className="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div className="p-6 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
          <h2 className="text-xl font-semibold text-gray-700">
            Agenda Maestra
          </h2>
          <span className="bg-purple-100 text-purple-800 text-sm font-bold px-3 py-1 rounded-full">
            Total en sistema: {citas.length}
          </span>
        </div>

        {cargando ? (
          <div className="p-12 text-center text-gray-500 animate-pulse flex flex-col items-center">
            <div className="w-10 h-10 border-4 border-purple-200 border-t-purple-600 rounded-full animate-spin mb-4"></div>
            Sincronizando base de datos...
          </div>
        ) : citas.length === 0 ? (
          <div className="p-16 text-center text-gray-500">
            <div className="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4 text-4xl">
              📭
            </div>
            <p className="font-medium text-gray-600 text-lg">
              No hay citas registradas.
            </p>
            <p className="text-sm mt-1">
              Cuando los pacientes soliciten citas, aparecerán aquí.
            </p>
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left border-collapse">
              <thead>
                <tr className="bg-white text-gray-500 text-sm border-b border-gray-100">
                  <th className="p-5 font-semibold">Fecha y Hora</th>
                  <th className="p-5 font-semibold">Motivo del Paciente</th>
                  <th className="p-5 font-semibold">Estado</th>
                  <th className="p-5 font-semibold text-right">
                    Acciones Administrativas
                  </th>
                </tr>
              </thead>
              <tbody className="divide-y divide-gray-50">
                {citas.map((cita) => (
                  <tr
                    key={cita.id}
                    className="hover:bg-purple-50/30 transition"
                  >
                    <td className="p-5">
                      <div className="font-bold text-gray-800 text-lg">
                        {cita.fecha}
                      </div>
                      <div className="text-sm text-gray-500 flex items-center gap-1 mt-1">
                        <svg
                          className="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            strokeLinecap="round"
                            strokeLinejoin="round"
                            strokeWidth="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                          ></path>
                        </svg>
                        {cita.hora}
                      </div>
                    </td>
                    <td className="p-5 text-gray-600 font-medium">
                      {cita.motivo}
                    </td>
                    <td className="p-5">
                      <span
                        className={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase border ${
                          cita.estado === "pendiente"
                            ? "bg-yellow-50 text-yellow-700 border-yellow-200"
                            : cita.estado === "confirmada"
                              ? "bg-green-50 text-green-700 border-green-200"
                              : "bg-red-50 text-red-700 border-red-200"
                        }`}
                      >
                        {cita.estado}
                      </span>
                    </td>
                    <td className="p-5 text-right">
                      {/* Botones de acción para la Secretaria */}
                      {cita.estado === "pendiente" && (
                        <div className="flex justify-end gap-2">
                          <button
                            onClick={() =>
                              cambiarEstadoCita(cita.id, "confirmada")
                            }
                            className="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-bold transition shadow-sm"
                          >
                            Confirmar
                          </button>
                          <button
                            onClick={() =>
                              cambiarEstadoCita(cita.id, "cancelada")
                            }
                            className="bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2 rounded-lg text-sm font-bold transition border border-red-200"
                          >
                            Rechazar
                          </button>
                        </div>
                      )}

                      {cita.estado === "confirmada" && (
                        <button
                          onClick={() =>
                            cambiarEstadoCita(cita.id, "cancelada")
                          }
                          className="bg-white hover:bg-gray-50 text-gray-600 px-4 py-2 rounded-lg text-sm font-bold transition border border-gray-300"
                        >
                          Cancelar Cita
                        </button>
                      )}

                      {cita.estado === "cancelada" && (
                        <span className="text-gray-400 text-sm font-medium italic">
                          Gestionada
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="frontend/src/app/dashboard-secretaria/recaudacion/page.tsx">
"use client";

import { useState, useEffect, useCallback } from "react";
import { supabase } from "../../../../lib/supabase";

interface Pago {
  id: string;
  referencia_unica: string;
  monto_esperado: number;
  monto_aplicado: number;
  saldo_actual: number;
  estado: string;
  fecha_creacion: string;
  comprobante_url: string | null;
  usuario_id: number;
  paciente_nombre?: string;
}

export default function CentroRecaudacionSecretaria() {
  const [cargando, setCargando] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [pagos, setPagos] = useState<Pago[]>([]);
  const [filtro, setFiltro] = useState<
    "revision" | "confirmados" | "pendientes"
  >("revision");

  const [procesandoPago, setProcesandoPago] = useState(false);
  const [pagoAConfirmar, setPagoAConfirmar] = useState<Pago | null>(null);
  const [visorComprobante, setVisorComprobante] = useState<string | null>(null);

  const cargarPagos = useCallback(async (mostrarLoader: boolean = false) => {
    if (mostrarLoader) setCargando(true);

    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();
      setError(null);
      if (sessionError || !session?.user?.id)
        throw new Error("Error de autenticación.");

      // 🟢 DELEGACIÓN: Buscar el psicólogo asignado a esta secretaria
      const { data: relacion, error: relError } = await supabase
        .from("secretaria_psicologo")
        .select("psicologo_id")
        .eq("secretaria_id", session.user.id)
        .maybeSingle();

      if (relError || !relacion?.psicologo_id) {
        throw new Error(
          "No tienes un psicólogo asignado. Contacta al administrador para vincular tu cuenta.",
        );
      }
      const psicologoId = relacion.psicologo_id;

      // Cargar pagos usando el ID del psicólogo delegado
      const { data: pagosDB, error: pagosError } = await supabase
        .from("pagos")
        .select("*")
        .eq("psicologo_id", psicologoId)
        .order("fecha_creacion", { ascending: false });

      if (pagosError)
        throw new Error("No se pudo cargar el historial de recaudación.");

      let pagosEnriquecidos: Pago[] = [];
      if (pagosDB && pagosDB.length > 0) {
        pagosEnriquecidos = await Promise.all(
          pagosDB.map(async (pago) => {
            let paciente_nombre = "Paciente Desconocido";
            if (pago.usuario_id) {
              const { data: usuario } = await supabase
                .from("roles_usuarios")
                .select("nombre, correo")
                .eq("id", pago.usuario_id)
                .maybeSingle();
              paciente_nombre =
                usuario?.nombre || usuario?.correo || "Paciente Desconocido";
            }
            return { ...pago, paciente_nombre } as Pago;
          }),
        );
      }
      setPagos(pagosEnriquecidos);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : "Error desconocido");
    } finally {
      setCargando(false);
    }
  }, []);

  useEffect(() => {
    const iniciarCarga = async () => {
      await cargarPagos(false);
    };
    iniciarCarga();
  }, [cargarPagos]);

  const registrarPagoConfirmado = async () => {
    if (!pagoAConfirmar) return;
    setProcesandoPago(true);

    try {
      const { error: rpcError } = await supabase.rpc(
        "rpc_registrar_pago_confirmado",
        {
          p_pago_id: pagoAConfirmar.id,
          p_monto_a_aplicar: pagoAConfirmar.monto_esperado,
        },
      );
      if (rpcError) throw rpcError;
      alert("Pago registrado correctamente.");
      setPagoAConfirmar(null);
      cargarPagos(true);
    } catch (err: unknown) {
      alert(
        `Operación denegada: ${err instanceof Error ? err.message : "Error al procesar el pago."}`,
      );
    } finally {
      setProcesandoPago(false);
    }
  };

  const getComprobanteUrl = (rutaStorage: string | null) => {
    if (!rutaStorage) return null;
    const { data } = supabase.storage
      .from("comprobantes_pagos")
      .getPublicUrl(rutaStorage);
    return data.publicUrl;
  };

  const pagosFiltrados = pagos.filter((p) => {
    if (filtro === "revision")
      return p.estado === "comprobante_recibido" || p.estado === "en_revision";
    if (filtro === "confirmados") return p.estado === "confirmado";
    if (filtro === "pendientes")
      return (
        p.estado === "pendiente_pago" ||
        p.estado === "informacion_adicional_requerida"
      );
    return true;
  });

  const getEstadoBadge = (estado: string) => {
    switch (estado) {
      case "confirmado":
        return (
          <span className="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-md font-bold text-xs uppercase">
            PAGADO
          </span>
        );
      case "en_revision":
      case "comprobante_recibido":
        return (
          <span className="bg-amber-100 text-amber-700 px-2.5 py-1 rounded-md font-bold text-xs uppercase flex items-center gap-1.5">
            <span className="w-1.5 h-1.5 bg-amber-500 rounded-full animate-pulse"></span>{" "}
            EN REVISIÓN
          </span>
        );
      case "pendiente_pago":
        return (
          <span className="bg-rose-100 text-rose-700 px-2.5 py-1 rounded-md font-bold text-xs uppercase">
            POR COBRAR
          </span>
        );
      default:
        return (
          <span className="bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md font-bold text-xs uppercase">
            {estado.replace("_", " ")}
          </span>
        );
    }
  };

  if (cargando)
    return (
      <div className="p-10 flex justify-center">
        <div className="w-8 h-8 border-4 border-purple-200 border-t-purple-600 rounded-full animate-spin"></div>
      </div>
    );

  return (
    <div className="p-6 md:p-10 w-full font-sans animate-in fade-in duration-500 max-w-7xl mx-auto pb-20">
      <div className="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 border-b border-slate-200 pb-8">
        <div>
          <h1 className="text-3xl md:text-4xl font-black text-slate-900 mb-2 tracking-tight">
            Centro de Recaudación
          </h1>
          <p className="text-slate-500 font-medium text-lg max-w-2xl">
            Gestiona las cuentas por cobrar y audita los comprobantes de los
            pacientes en nombre del especialista.
          </p>
        </div>

        <div className="flex gap-4 shrink-0 overflow-x-auto pb-2 md:pb-0">
          <div className="bg-rose-50 border border-rose-100 rounded-2xl p-4 text-center min-w-30">
            <p className="text-3xl font-black text-rose-600">
              {pagos.filter((p) => p.estado === "pendiente_pago").length}
            </p>
            <p className="text-[10px] font-bold text-rose-700 uppercase tracking-wider mt-1">
              Por Cobrar
            </p>
          </div>
          <div className="bg-amber-50 border border-amber-100 rounded-2xl p-4 text-center min-w-30 shadow-sm">
            <p className="text-3xl font-black text-amber-600">
              {
                pagos.filter(
                  (p) =>
                    p.estado === "comprobante_recibido" ||
                    p.estado === "en_revision",
                ).length
              }
            </p>
            <p className="text-[10px] font-bold text-amber-700 uppercase tracking-wider mt-1">
              En Revisión
            </p>
          </div>
          <div className="bg-emerald-50 border border-emerald-100 rounded-2xl p-4 text-center min-w-30">
            <p className="text-3xl font-black text-emerald-600">
              {pagos.filter((p) => p.estado === "confirmado").length}
            </p>
            <p className="text-[10px] font-bold text-emerald-700 uppercase tracking-wider mt-1">
              Confirmados
            </p>
          </div>
        </div>
      </div>

      {error && (
        <div className="bg-red-50 text-red-600 p-4 rounded-xl font-bold mb-6 border border-red-200 shadow-sm">
          {error}
        </div>
      )}

      <div className="flex overflow-x-auto hide-scrollbar gap-2 mb-8 bg-white p-1.5 rounded-2xl border border-slate-200 shadow-sm w-full md:w-fit">
        <button
          onClick={() => setFiltro("revision")}
          className={`px-8 py-3 rounded-xl font-bold text-sm transition-all whitespace-nowrap flex items-center gap-2 ${filtro === "revision" ? "bg-amber-500 text-white shadow-md" : "text-slate-500 hover:bg-amber-50 hover:text-amber-600"}`}
        >
          En Revisión{" "}
          <span className="bg-white/20 px-2 py-0.5 rounded-md text-xs">
            {
              pagos.filter(
                (p) =>
                  p.estado === "comprobante_recibido" ||
                  p.estado === "en_revision",
              ).length
            }
          </span>
        </button>
        <button
          onClick={() => setFiltro("confirmados")}
          className={`px-8 py-3 rounded-xl font-bold text-sm transition-all whitespace-nowrap ${filtro === "confirmados" ? "bg-emerald-600 text-white shadow-md" : "text-slate-500 hover:bg-emerald-50 hover:text-emerald-600"}`}
        >
          Pagos Confirmados
        </button>
        <button
          onClick={() => setFiltro("pendientes")}
          className={`px-8 py-3 rounded-xl font-bold text-sm transition-all whitespace-nowrap ${filtro === "pendientes" ? "bg-slate-800 text-white shadow-md" : "text-slate-500 hover:bg-slate-100 hover:text-slate-800"}`}
        >
          Cuentas por Cobrar
        </button>
      </div>

      <div className="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden animate-in slide-in-from-bottom-4 duration-500">
        {pagosFiltrados.length === 0 ? (
          <div className="p-16 text-center">
            <div className="w-20 h-20 bg-slate-50 text-slate-300 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg
                className="w-10 h-10"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
