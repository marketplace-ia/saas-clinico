<file path="frontend/src/app/api/admin/suscripciones/aprobar/route.ts">
import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

const supabaseAdmin = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!,
);

export async function POST(request: Request) {
  try {
    const { pago_id } = await request.json();
    if (!pago_id) throw new Error("Falta el ID del pago.");

    const { data: pago, error: errPago } = await supabaseAdmin
      .from("pagos")
      .select("*")
      .eq("id", pago_id)
      .single();
    if (errPago || !pago) throw new Error("Transacción no encontrada.");

    const { data: tenantUsers, error: errTu } = await supabaseAdmin
      .from("tenant_users")
      .select("tenant_id")
      .eq("usuario_id", pago.psicologo_id);
    if (errTu)
      throw new Error("Error consultando la base de datos: " + errTu.message);

    let tenantId = pago.tenant_id;
    if (!tenantId) {
      if (!tenantUsers || tenantUsers.length === 0) {
        throw new Error(
          `DATO HUÉRFANO: El psicólogo (ID: ${pago.psicologo_id}) no tiene clínica asignada.`,
        );
      }
      tenantId = tenantUsers[0].tenant_id;
    }

    // 1. Aplicamos la aprobación final en el pago
    await supabaseAdmin
      .from("pagos")
      .update({ estado: "aprobado" })
      .eq("id", pago_id);

    // 2. Activamos el tenant en el motor C.A.S.E. (Esto le quita el bloqueo al psicólogo)
    await supabaseAdmin
      .from("tenants")
      .update({ estado_suscripcion: "active" })
      .eq("id", tenantId);

    return NextResponse.json({
      success: true,
      mensaje: "Suscripción SaaS activada con éxito.",
    });
  } catch (error: unknown) {
    let msg = "Error desconocido en el servidor";
    if (error instanceof Error) msg = error.message;
    else if (typeof error === "object" && error !== null && "message" in error)
      msg = String((error as { message: unknown }).message);

    return NextResponse.json({ error: msg }, { status: 500 });
  }
}
</file>

<file path="frontend/src/app/api/admin/suscripciones/rechazar/route.ts">
import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

const supabaseAdmin = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!,
);

export async function POST(request: Request) {
  try {
    const { pago_id } = await request.json();
    if (!pago_id) throw new Error("Falta el ID del pago en la petición.");

    // 1. EL TRUCO NINJA: Satisfacer la máquina de estados de la BD pasando por "en_revision"
    await supabaseAdmin
      .from("pagos")
      .update({ estado: "en_revision" })
      .eq("id", pago_id);

    // 2. Ahora sí, aplicamos el rechazo final
    const { data, error } = await supabaseAdmin
      .from("pagos")
      .update({ estado: "rechazado" })
      .eq("id", pago_id)
      .select();

    if (error) throw new Error(`Error BD: ${error.message}`);
    if (!data || data.length === 0) throw new Error("No se encontró el pago.");

    return NextResponse.json({
      success: true,
      mensaje:
        "Comprobante rechazado exitosamente. La cuenta sigue restringida.",
    });
  } catch (error: unknown) {
    let msg = "Error desconocido en el servidor";
    if (error instanceof Error) msg = error.message;
    else if (typeof error === "object" && error !== null && "message" in error)
      msg = String(error.message);

    return NextResponse.json({ error: msg }, { status: 500 });
  }
}
</file>

<file path="frontend/src/app/api/billing/emitir/route.ts">
// src/app/api/billing/emitir/route.ts
import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";
import { FactuplanAdapter } from "@/lib/billing/FactuplanAdapter";
import { InvoicePayload } from "@/lib/billing/BillingProvider";

// Inicializamos el cliente de Supabase con Service Role (Solo para backend)
// Esto permite al servidor leer/escribir de forma segura tras verificar la identidad.
const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL!;
const supabaseServiceKey = process.env.SUPABASE_SERVICE_ROLE_KEY!;
const supabase = createClient(supabaseUrl, supabaseServiceKey);

export async function POST(request: Request) {
  try {
    // 1. Validar Autenticación del Emisor
    const authHeader = request.headers.get("Authorization");
    if (!authHeader) {
      return NextResponse.json({ error: "No autorizado" }, { status: 401 });
    }

    const token = authHeader.replace("Bearer ", "");
    const {
      data: { user },
      error: authError,
    } = await supabase.auth.getUser(token);
    if (authError || !user) {
      return NextResponse.json({ error: "Sesión inválida" }, { status: 401 });
    }
    const psicologoId = user.id;

    // 2. Extraer el pago a facturar
    const body = await request.json();
    const { pago_id } = body;
    if (!pago_id)
      return NextResponse.json(
        { error: "ID de pago requerido" },
        { status: 400 },
      );

    // 3. Recopilar Datos (Pago, Tributario, Configuración)
    const { data: pago } = await supabase
      .from("pagos")
      .select("*")
      .eq("id", pago_id)
      .single();
    if (!pago || pago.psicologo_id !== psicologoId) {
      return NextResponse.json(
        { error: "Pago no encontrado o no autorizado" },
        { status: 404 },
      );
    }
    if (pago.estado !== "confirmado") {
      return NextResponse.json(
        { error: "El pago debe estar confirmado para facturar" },
        { status: 400 },
      );
    }

    const { data: tributario } = await supabase
      .from("perfil_tributario_psicologo")
      .select("*")
      .eq("psicologo_id", psicologoId)
      .single();
    const { data: configuracion } = await supabase
      .from("configuracion_facturacion_psicologo")
      .select("*")
      .eq("psicologo_id", psicologoId)
      .single();
    const { data: paciente } = await supabase
      .from("roles_usuarios")
      .select("*")
      .eq("id", pago.usuario_id)
      .single();

    if (!tributario || !configuracion) {
      return NextResponse.json(
        { error: "Perfil tributario incompleto" },
        { status: 400 },
      );
    }

    // 4. Preparar el Contrato (InvoicePayload)
    // OJO: Clinesfera orquesta, pero el RUC y los datos son del Psicólogo
    const payload: InvoicePayload = {
      referencia_interna: pago.referencia_unica,
      emisor: {
        psicologo_id: psicologoId,
        provider_customer_id: tributario.ruc, // Usamos el RUC como ID de sub-cuenta
        establecimiento: configuracion.establecimiento,
        punto_emision: configuracion.punto_emision,
      },
      receptor: {
        identificacion: "9999999999", // Consumidor final por defecto (Mejorable pidiendo datos al paciente)
        tipo_identificacion: "cedula",
        razon_social: paciente?.nombre || "Consumidor Final",
        direccion: "Ecuador",
        correo: paciente?.correo || "",
      },
      detalles: [
        {
          codigo: "SRV-PSI-01",
          descripcion: "Servicios Profesionales de Psicología",
          cantidad: 1,
          precio_unitario: Number(pago.monto_aplicado),
          descuento: 0,
          impuestos: "IVA_0", // Servicios de salud graban 0% en Ecuador
        },
      ],
      pagos: [
        {
          forma_pago: "transferencia",
          total: Number(pago.monto_aplicado),
        },
      ],
    };

    // 5. Instanciar el Adaptador (Candidato: Factuplan)
    // Las API Keys reales vivirán en tu archivo .env
    const provider = new FactuplanAdapter("mock_api_key_sandbox", "testing");

    // 6. Idempotencia: Usamos el ID del pago para no generar facturas dobles jamás
    const idempotencyKey = `inv_create_${pago.id}`;

    // 7. Ejecutar Operación de Transmisión
    const resultado = await provider.submitInvoice(payload, idempotencyKey);

    if (!resultado.exito) {
      return NextResponse.json(
        {
          error: "El proveedor rechazó la solicitud inicial",
          detalles: resultado.errores,
        },
        { status: 502 },
      );
    }

    // 8. Persistir el Estado en Base de Datos
    const { error: dbError } = await supabase
      .from("facturas_electronicas")
      .insert({
        psicologo_id: psicologoId,
        pago_id: pago.id,
        usuario_id: pago.usuario_id,
        referencia_interna: pago.referencia_unica,
        factura_id_proveedor: resultado.factura_id_proveedor,
        estado_sri: resultado.estado_sri,
        datos_emisor_snapshot: tributario, // Inmutabilidad histórica asegurada
        datos_receptor_snapshot: payload.receptor,
        detalles_snapshot: payload.detalles,
      });

    if (dbError) throw dbError;

    return NextResponse.json({
      mensaje: "Documento enviado al proveedor correctamente.",
      estado: resultado.estado_sri,
    });
  } catch (error: unknown) {
    const msj =
      error instanceof Error ? error.message : "Error interno del servidor";
    console.error("[Billing API] Error:", msj);
    return NextResponse.json({ error: msj }, { status: 500 });
  }
}
</file>

