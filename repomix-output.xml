import { NextResponse } from "next/server";
import { google } from "googleapis";
import { createClient } from "@supabase/supabase-js";
import { CASEngine } from "@/lib/case-engine";

const supabaseAdmin = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!,
);

// Estas credenciales se sacan de Google Cloud Console y se ponen en tu .env.local
const oauth2Client = new google.auth.OAuth2(
  process.env.GOOGLE_CLIENT_ID,
  process.env.GOOGLE_CLIENT_SECRET,
  process.env.NEXT_PUBLIC_APP_URL + "/api/calendario/callback", // URL de retorno
);

export async function POST(request: Request) {
  try {
    // 1. EL GUARDIÁN: Validar que el psicólogo tiene la capacidad (Entitlement)
    const ctx = await CASEngine.authorize(
      request.headers.get("Authorization"),
      {
        actionType: "write",
        requiredEntitlement: "google.calendar", // Solo planes que incluyen Google Calendar
      },
    );

    const { cita_id } = await request.json();

    // 2. Extraer el Refresh Token seguro de la base de datos
    const { data: integracion } = await supabaseAdmin
      .from("integraciones_oauth")
      .select("refresh_token")
      .eq("psicologo_id", ctx.userId)
      .eq("proveedor", "google_calendar")
      .single();

    if (!integracion) {
      return NextResponse.json(
        { error: "Google Calendar no está conectado." },
        { status: 400 },
      );
    }

    // 3. Cargar credenciales
    oauth2Client.setCredentials({ refresh_token: integracion.refresh_token });
    const calendar = google.calendar({ version: "v3", auth: oauth2Client });

    // 4. Obtener datos de la Cita de Clinesfera
    const { data: cita } = await supabaseAdmin
      .from("citas")
      .select("*")
      .eq("id", cita_id)
      .single();
    if (!cita) throw new Error("Cita no encontrada.");

    // 5. Configurar el evento de Google
    const fechaInicio = new Date(cita.fecha_hora);
    const fechaFin = new Date(fechaInicio);
    fechaFin.setMinutes(fechaInicio.getMinutes() + 50); // Sesiones de 50 min

    const evento = {
      summary: `Clinesfera: Sesión con ${cita.paciente_nombre}`,
      description: `Teleconsulta ID: ${cita.id}\nTeléfono: ${cita.paciente_telefono || "N/A"}`,
      start: {
        dateTime: fechaInicio.toISOString(),
        timeZone: "America/Guayaquil",
      },
      end: { dateTime: fechaFin.toISOString(), timeZone: "America/Guayaquil" },
      colorId: "5", // Color amarillo/mostaza en Google
    };

    // 6. Inyectar en Google Calendar (Comunicación Segura)
    const response = await calendar.events.insert({
      calendarId: "primary",
      requestBody: evento,
    });

    return NextResponse.json({
      success: true,
      googleEventId: response.data.id,
    });
  } catch (error: unknown) {
    console.error("[Google Calendar Sync Error]:", error);
    return NextResponse.json(
      { error: "Error sincronizando con Google Calendar" },
      { status: 500 },
    );
  }
}
</file>

<file path="frontend/src/app/api/citas/agendar/route.ts">
import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL!;
const supabaseKey = process.env.SUPABASE_SERVICE_ROLE_KEY!;
const supabase = createClient(supabaseUrl, supabaseKey);

export async function POST(req: Request) {
  try {
    const {
      psicologo_id,
      paciente_correo,
      paciente_nombre,
      fecha,
      hora_inicio,
    } = await req.json();

    if (!psicologo_id || !paciente_correo || !fecha || !hora_inicio) {
      return NextResponse.json(
        { error: "Faltan datos obligatorios para agendar." },
        { status: 400 },
      );
    }

    // 1. Obtener ID del paciente y precio del psicólogo
    const [pacienteRes, psicologoRes] = await Promise.all([
      supabase
        .from("roles_usuarios")
        .select("id")
        .eq("correo", paciente_correo)
        .single(),
      supabase
        .from("perfil_psicologo")
        .select("precio_consulta")
        .eq("psicologo_id", psicologo_id)
        .single(),
    ]);

    if (pacienteRes.error || !pacienteRes.data)
      throw new Error("Paciente no encontrado en el sistema.");
    const precio = psicologoRes.data?.precio_consulta || 50.0;

    // 2. Calcular hora de fin (+1 hora)
    const horaInicioObj = new Date(`2000-01-01T${hora_inicio}`);
    horaInicioObj.setHours(horaInicioObj.getHours() + 1);
    const hora_fin = horaInicioObj.toTimeString().split(" ")[0];

    // 3. Crear la Cita
    const { data: cita, error: errCita } = await supabase
      .from("citas")
      .insert({
        psicologo_id,
        nombre_paciente: paciente_nombre,
        paciente_correo,
        fecha,
        hora_inicio,
        hora_fin,
        modalidad: "Virtual",
        estado: "Programada",
      })
      .select("id")
      .single();

    if (errCita || !cita)
      throw new Error("No se pudo reservar la hora elegida.");

    // 4. Generar Referencia Única Financiera
    const year = new Date().getFullYear();
    const randomCode = Math.random().toString(36).substring(2, 8).toUpperCase();
    const referenciaUnica = `CIT-${year}-${randomCode}`;

    // 5. Crear la Intención de Pago
    const { error: errPago } = await supabase.from("pagos").insert({
      usuario_id: pacienteRes.data.id,
      referencia_unica: referenciaUnica,
      entidad_tipo: "cita",
      entidad_id: cita.id,
      monto: precio,
      estado: "pendiente_pago",
      metodo_pago: "bank_transfer",
    });

    if (errPago)
      throw new Error("Cita creada, pero falló la generación de cobro.");

    return NextResponse.json({
      success: true,
      cita_id: cita.id,
      referencia: referenciaUnica,
    });
  } catch (error: unknown) {
    const mensaje =
      error instanceof Error ? error.message : "Error interno del servidor";
    return NextResponse.json({ error: mensaje }, { status: 500 });
  }
}
</file>

<file path="frontend/src/app/api/equipo/crear-secretaria/route.ts">
import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

// Usamos la Service Role Key para poder crear usuarios sin cerrar la sesión del psicólogo
const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL!;
const supabaseServiceKey = process.env.SUPABASE_SERVICE_ROLE_KEY!;
const supabaseAdmin = createClient(supabaseUrl, supabaseServiceKey, {
  auth: {
    autoRefreshToken: false,
    persistSession: false,
  },
});

export async function POST(request: Request) {
  try {
    // 1. Validar quién está haciendo la petición (Debe ser un psicólogo logueado)
    const authHeader = request.headers.get("Authorization");
    if (!authHeader)
      return NextResponse.json({ error: "No autorizado" }, { status: 401 });

    const token = authHeader.replace("Bearer ", "");
    const {
      data: { user: psicologo },
      error: authError,
    } = await supabaseAdmin.auth.getUser(token);
    if (authError || !psicologo)
      return NextResponse.json({ error: "Sesión inválida" }, { status: 401 });

    // 2. Recibir los datos de la nueva secretaria desde el frontend
    const body = await request.json();
    const { email, password, nombre } = body;

    if (!email || !password || !nombre) {
      return NextResponse.json(
        { error: "Faltan datos obligatorios" },
        { status: 400 },
      );
    }

    // 3. Crear el usuario en Supabase Auth (Sin cerrar la sesión actual)
    const { data: authData, error: createError } =
      await supabaseAdmin.auth.admin.createUser({
        email: email,
        password: password,
        email_confirm: true, // Auto-confirmamos para que pueda entrar de inmediato
        user_metadata: {
          rol: "secretaria",
          nombre: nombre,
        },
      });

    if (createError) throw createError;
    const secretariaId = authData.user.id;

    // 4. Registrar en roles_usuarios (Opcional, según tu arquitectura actual)
    // Nota: Si el ID de roles_usuarios es BIGINT, podrías necesitar un manejo distinto aquí.
    // Si es UUID (igual al de auth.users), esto funcionará perfectamente.
    await supabaseAdmin.from("roles_usuarios").insert({
      correo: email,
      rol: "secretaria",
      nombre: nombre,
    });

    // 5. 🟢 LA MAGIA DE SEGURIDAD: Vincular automáticamente la secretaria al psicólogo
    const { error: vinculacionError } = await supabaseAdmin
      .from("secretaria_psicologo")
      .insert({
        secretaria_id: secretariaId,
        psicologo_id: psicologo.id,
      });

    if (vinculacionError) throw vinculacionError;

    // 6. 🟢 LA MAGIA VISUAL: Crear el perfil para que aparezca en la lista "Mi Equipo"
    const { error: perfilError } = await supabaseAdmin
      .from("perfil_secretaria")
      .insert({
        id: secretariaId,
        psicologo_id: psicologo.id,
        nombre: nombre,
        correo: email,
        estado: "activo",
      });

    if (perfilError) throw perfilError;

    return NextResponse.json({
      mensaje: "Secretaria creada, perfil generado y vinculada exitosamente",
      secretaria_id: secretariaId,
    });
  } catch (error: unknown) {
    const msj =
      error instanceof Error ? error.message : "Error interno del servidor";
    console.error("[API Crear Secretaria]:", msj);
    return NextResponse.json({ error: msj }, { status: 500 });
  }
}
</file>

<file path="frontend/src/app/api/pacientes/agendar/route.ts">
import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";
import crypto from "crypto";

const supabaseAdmin = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!,
);
const MAX_FILE_SIZE = 5 * 1024 * 1024;
const ALLOWED_MIMES = ["image/jpeg", "image/png", "application/pdf"];

export async function POST(request: Request) {
  try {
    const formData = await request.formData();
    const psicologo_id = formData.get("psicologo_id") as string;
    const file = formData.get("comprobante") as File;
    const fechaHora = formData.get("fechaHora") as string;

    if (!psicologo_id || !file)
      return NextResponse.json({ error: "Datos incompletos" }, { status: 400 });

    // 1. VALIDACIÓN MIME STRICTA (Server-side, ignora la extensión del nombre del archivo)
    if (!ALLOWED_MIMES.includes(file.type)) {
      return NextResponse.json(
        { error: "Formato no permitido. Solo JPG, PNG o PDF." },
        { status: 400 },
      );
    }
    if (file.size > MAX_FILE_SIZE)
      return NextResponse.json({ error: "Excede 5MB" }, { status: 400 });

    // 2. SERVER DETERMINA EL TENANT (Aislamiento)
    const { data: tenantUser } = await supabaseAdmin
      .from("tenant_users")
      .select("tenant_id")
      .eq("usuario_id", psicologo_id)
      .single();
    if (!tenantUser) throw new Error("Clínica no válida.");

    // 3. STORAGE CON RUTA GENERADA POR SERVIDOR (Mitigación de colisiones y path traversal)
    const fileBuffer = await file.arrayBuffer();
    const safeFileName = `pacientes/${tenantUser.tenant_id}/${crypto.randomUUID()}`;

    await supabaseAdmin.storage
      .from("comprobantes_pacientes")
      .upload(safeFileName, fileBuffer, { contentType: file.type });

    // 4. ESTADOS INICIALES ESTRICTOS (Desacoplados)
    const { data: cita } = await supabaseAdmin
      .from("citas")
      .insert({
        tenant_id: tenantUser.tenant_id,
        psicologo_id: psicologo_id,
        paciente_nombre: formData.get("nombre") as string,
        fecha_hora: fechaHora,
        estado: "requested", // Ciclo de cita
      })
      .select()
      .single();

    await supabaseAdmin.from("recaudacion_pacientes").insert({
      tenant_id: tenantUser.tenant_id,
      cita_id: cita!.id,
      psicologo_id: psicologo_id,
      monto_pagado: parseFloat(formData.get("monto") as string),
      comprobante_url: safeFileName,
      estado_pago: "under_review", // Ciclo de pago
    });

    return NextResponse.json({ success: true });
  } catch (error: unknown) {
    // 🟢 CORRECCIÓN ESLINT: Ahora "usamos" la variable registrándola en los logs internos del servidor
    console.error("[API Agendar Error]:", error);
    return NextResponse.json(
      { error: "Error interno en el servidor." },
      { status: 500 },
    );
  }
}
</file>

