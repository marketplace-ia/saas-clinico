    const body = await req.json();
    const { pago_id, comprobante_url, correo } = body;

    if (!pago_id || !comprobante_url || !correo) {
      return NextResponse.json(
        { error: "Datos de comprobante incompletos" },
        { status: 400 },
      );
    }

    // 1. Validar identidad del usuario
    const { data: usuario, error: errUsuario } = await supabase
      .from("roles_usuarios")
      .select("id")
      .eq("correo", correo)
      .single();

    if (errUsuario || !usuario) throw new Error("Usuario no autorizado.");

    // 2. Obtener el estado actual del pago para la auditoría
    const { data: pagoActual, error: errPago } = await supabase
      .from("pagos")
      .select("estado")
      .eq("id", pago_id)
      .single();

    if (errPago || !pagoActual) throw new Error("Transacción no encontrada.");

    // 3. Actualizar el registro del pago (Marcamos el comprobante como recibido)
    const { error: errUpdate } = await supabase
      .from("pagos")
      .update({
        estado: "comprobante_recibido",
        comprobante_url: comprobante_url,
      })
      .eq("id", pago_id);

    if (errUpdate)
      throw new Error("Error al adjuntar el comprobante en la base de datos.");

    // 4. Escribir en la Bitácora (Trazabilidad obligatoria)
    await supabase.from("historial_estados_pago").insert({
      pago_id: pago_id,
      estado_anterior: pagoActual.estado,
      estado_nuevo: "comprobante_recibido",
      cambiado_por: usuario.id,
      observacion:
        "El usuario ha subido el comprobante de transferencia correctamente.",
    });

    return NextResponse.json({
      success: true,
      mensaje: "Comprobante procesado y guardado en estado 'En revisión'.",
    });
  } catch (error: unknown) {
    const mensajeError =
      error instanceof Error ? error.message : "Error desconocido";
    console.error("Error crítico en API de Comprobantes:", mensajeError);
    return NextResponse.json({ error: mensajeError }, { status: 500 });
  }
}
