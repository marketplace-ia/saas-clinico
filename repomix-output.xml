    titulo: "",
    contenido: "",
    color: "bg-yellow-100",
  });

  const cargarNotas = useCallback(async () => {
    try {
      const {
        data: { session },
      } = await supabase.auth.getSession();
      if (!session) return;

      const { data, error } = await supabase
        .from("notas_psicologo")
        .select("*")
        .eq("psicologo_id", session.user.id)
        .order("creado_en", { ascending: false });

      if (error) throw error;
      if (data) setNotas(data);
    } catch (error) {
      console.error("Error cargando notas:", error);
    } finally {
      setCargando(false);
    }
  }, []);

  useEffect(() => {
    const inicializar = async () => await cargarNotas();
    inicializar();
  }, [cargarNotas]);

  const guardarNota = async (e: React.FormEvent) => {
    e.preventDefault();
    setGuardando(true);

    try {
      const {
        data: { session },
      } = await supabase.auth.getSession();
      if (!session) return;

      const { error } = await supabase.from("notas_psicologo").insert([
        {
          psicologo_id: session.user.id,
          titulo: nuevaNota.titulo,
          contenido: nuevaNota.contenido,
          color: nuevaNota.color,
        },
      ]);

      if (error) throw error;

      setNuevaNota({ titulo: "", contenido: "", color: "bg-yellow-100" });
      setModalAbierto(false);
      cargarNotas();
    } catch (error) {
      console.error("Error al guardar:", error);
      alert("Hubo un error al guardar la nota.");
    } finally {
      setGuardando(false);
    }
  };

  const eliminarNota = async (id: string) => {
    if (!confirm("¿Estás seguro de que deseas eliminar esta nota?")) return;

    try {
      const { error } = await supabase
        .from("notas_psicologo")
        .delete()
        .eq("id", id);
      if (error) throw error;
      cargarNotas();
    } catch (error) {
      console.error("Error eliminando:", error);
      alert("Error al eliminar la nota.");
    }
  };

  return (
    <div className="p-6 md:p-8 max-w-7xl mx-auto animate-in fade-in duration-500 h-full flex flex-col">
      {/* CABECERA */}
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
          <h1 className="text-3xl font-black text-slate-900 mb-2">
            Mis Notas Privadas
          </h1>
          <p className="text-slate-500 font-medium">
            Apuntes rápidos, hipótesis o recordatorios (no visibles en historias
            clínicas).
          </p>
        </div>
        <button
          onClick={() => setModalAbierto(true)}
          className="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-xl shadow-md transition-all flex items-center gap-2"
        >
          <svg
            className="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              strokeLinecap="round"
              strokeLinejoin="round"
              strokeWidth={2}
              d="M12 4v16m8-8H4"
            />
          </svg>
          Nueva Nota
        </button>
      </div>

      {/* REJILLA DE NOTAS */}
      {cargando ? (
        <div className="flex-1 flex items-center justify-center">
          <div className="w-10 h-10 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin"></div>
        </div>
      ) : notas.length === 0 ? (
        <div className="flex-1 flex flex-col items-center justify-center bg-white border border-dashed border-slate-300 rounded-3xl p-12 text-center">
          <div className="w-20 h-20 bg-yellow-50 rounded-full flex items-center justify-center mb-4 shadow-sm">
            <svg
              className="w-10 h-10 text-yellow-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth={2}
                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
              />
            </svg>
          </div>
          <h3 className="text-xl font-bold text-slate-700 mb-2">
            Tu bloc está vacío
          </h3>
          <p className="text-slate-500 max-w-sm">
            Haz clic en &quot;Nueva Nota&quot; para crear tu primer apunte
            rápido.
          </p>
        </div>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 items-start">
          {notas.map((nota) => (
            <div
              key={nota.id}
              className={`${nota.color} p-6 rounded-3xl shadow-sm border border-black/5 flex flex-col gap-3 group relative transform hover:-translate-y-1 transition-all duration-200`}
            >
              <button
                onClick={() => eliminarNota(nota.id)}
                className="absolute top-4 right-4 text-black/20 hover:text-red-500 transition-colors opacity-0 group-hover:opacity-100"
                title="Eliminar nota"
              >
                <svg
                  className="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    strokeWidth={2}
                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                  />
                </svg>
              </button>

              <h3 className="font-black text-lg text-slate-900 pr-6 leading-tight">
                {nota.titulo}
              </h3>
              <p className="text-slate-700 text-sm whitespace-pre-wrap flex-1">
                {nota.contenido}
              </p>

              <div className="text-[10px] font-bold text-black/30 uppercase tracking-wider mt-4">
                {new Date(nota.creado_en).toLocaleDateString("es-ES", {
                  day: "2-digit",
                  month: "short",
                  year: "numeric",
                })}
              </div>
            </div>
          ))}
        </div>
      )}

      {/* MODAL NUEVA NOTA */}
      {modalAbierto && (
        <div className="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4 backdrop-blur-sm animate-in fade-in duration-200">
          <div className="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden flex flex-col animate-in zoom-in-95 duration-200">
            <div className="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50">
              <h2 className="text-2xl font-black text-slate-900">
                Crear Apunte
              </h2>
              <button
                onClick={() => setModalAbierto(false)}
                className="text-slate-400 hover:text-red-500 transition-colors bg-white p-2 rounded-full shadow-sm"
              >
                <svg
                  className="w-6 h-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    strokeWidth={2}
                    d="M6 18L18 6M6 6l12 12"
                  />
                </svg>
              </button>
            </div>

            <form onSubmit={guardarNota} className="p-6 space-y-5">
              <div>
                <input
                  type="text"
                  required
                  value={nuevaNota.titulo}
                  onChange={(e) =>
                    setNuevaNota({ ...nuevaNota, titulo: e.target.value })
                  }
                  className="w-full px-0 py-2 border-0 border-b-2 border-slate-200 focus:border-indigo-500 focus:ring-0 text-xl font-black text-slate-900 placeholder:text-slate-300 transition-colors outline-none bg-transparent"
                  placeholder="Título de la nota..."
                />
              </div>

              <div>
                <textarea
                  required
                  rows={5}
                  value={nuevaNota.contenido}
                  onChange={(e) =>
                    setNuevaNota({ ...nuevaNota, contenido: e.target.value })
                  }
                  className="w-full px-4 py-3 rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all text-slate-700 resize-none font-medium"
                  placeholder="Escribe aquí los detalles..."
                ></textarea>
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">
                  Color de la nota
                </label>
                <div className="flex gap-3">
                  {COLORES_DISPONIBLES.map((color) => (
                    <button
                      key={color.id}
                      type="button"
                      onClick={() =>
                        setNuevaNota({ ...nuevaNota, color: color.id })
                      }
                      className={`w-8 h-8 rounded-full border-2 transition-all transform hover:scale-110 ${color.clase} ${nuevaNota.color === color.id ? "border-indigo-600 scale-110 shadow-md" : "border-transparent"}`}
                    />
                  ))}
                </div>
              </div>

              <div className="pt-4 mt-2">
                <button
                  type="submit"
                  disabled={guardando}
                  className="w-full px-8 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg transition-all disabled:opacity-50 flex items-center justify-center"
                >
                  {guardando ? "Guardando..." : "Guardar Nota"}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/app/dashboard-psicologo/suscripcion/page.tsx">
"use client";

import { useState, useEffect, useCallback } from "react";
import { useRouter } from "next/navigation";
import { supabase } from "../../../../lib/supabase";

interface Plan {
  id: string;
  nombre: string;
  descripcion: string;
  precio_mensual: number;
  precio_anual: number;
  caracteristicas: string[];
}
interface DatosBancarios {
  banco: string;
  tipo_cuenta: string;
  numero_cuenta: string;
  titular: string;
  identificacion: string;
  correo_pagos: string;
}
interface Desglose {
  subtotal: number;
  impuestos: number;
  total: number;
}

export default function CheckoutSaaSPremium() {
  const router = useRouter();

  // Estados de máquina
  const [paso, setPaso] = useState<1 | 2 | 3 | 4>(1);
  const [cargando, setCargando] = useState(true);
  const [procesando, setProcesando] = useState(false);
  const [errorUI, setErrorUI] = useState<string | null>(null);

  // Estados de negocio (Controlados por Backend)
  const [planes, setPlanes] = useState<Plan[]>([]);
  const [datosBancarios, setDatosBancarios] = useState<DatosBancarios | null>(
    null,
  );
  const [frecuencia, setFrecuencia] = useState<"mensual" | "anual">("mensual");

  // Datos inmutables de la transacción
  const [transaccion, setTransaccion] = useState<{
    plan?: Plan;
    pago_id?: string;
    referencia?: string;
    desglose?: Desglose;
  }>({});

  const [archivo, setArchivo] = useState<File | null>(null);
  const [copiado, setCopiado] = useState("");

  const cargarDatosSaaS = useCallback(async () => {
    try {
      const {
        data: { session },
      } = await supabase.auth.getSession();
      if (!session) {
        router.push("/login");
        return;
      }

      const { data: planesDB } = await supabase
        .from("planes")
        .select("*")
        .eq("activo", true)
        .order("precio_mensual", { ascending: true });
      if (planesDB) setPlanes(planesDB);

      // Simulación de configuración bancaria oficial
      setDatosBancarios({
        banco: "Banco Pichincha",
        tipo_cuenta: "Corriente",
        numero_cuenta: "2100000000",
        titular: "Clinesfera SaaS S.A.",
        identificacion: "1790000000001",
        correo_pagos: "pagos@clinesfera.com",
      });
    } catch (error: unknown) {
      console.error(error);
      setErrorUI("No se pudo conectar con el sistema financiero.");
    } finally {
      setCargando(false);
    }
  }, [router]);

  useEffect(() => {
    const inicializar = async () => {
      await cargarDatosSaaS();
    };
    inicializar();
  }, [cargarDatosSaaS]);

  const copiarTexto = (texto: string, id: string) => {
    navigator.clipboard.writeText(texto);
    setCopiado(id);
    setTimeout(() => setCopiado(""), 3000);
  };

  const procesarIntencionDePago = async (plan: Plan) => {
    setProcesando(true);
    setErrorUI(null);
    try {
      const {
        data: { session },
      } = await supabase.auth.getSession();

      const res = await fetch("/api/suscripciones/intencion", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${session?.access_token}`,
        },
        body: JSON.stringify({ plan_id: plan.id, frecuencia }), // NO enviamos precios
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error);

      setTransaccion({
        plan,
        pago_id: data.pago_id,
        referencia: data.referencia,
        desglose: data.desglose,
      });

      setPaso(2);
      window.scrollTo({ top: 0, behavior: "smooth" });
    } catch (error: unknown) {
      setErrorUI(
        error instanceof Error
          ? error.message
          : "Error al generar la transacción.",
      );
    } finally {
      setProcesando(false);
    }
  };

  const procesarComprobante = async () => {
    if (!archivo || !transaccion.pago_id) return;
    setProcesando(true);
    setErrorUI(null);

    try {
      const {
        data: { session },
      } = await supabase.auth.getSession();
      const formData = new FormData();
      formData.append("comprobante", archivo);
      formData.append("pago_id", transaccion.pago_id);

      const res = await fetch("/api/suscripciones/comprobante", {
        method: "POST",
        headers: { Authorization: `Bearer ${session?.access_token}` },
        body: formData, // Upload directo a nuestro Backend seguro
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error);

      setPaso(4);
      window.scrollTo({ top: 0, behavior: "smooth" });
    } catch (error: unknown) {
      setErrorUI(
        error instanceof Error
          ? error.message
          : "No pudimos procesar el comprobante.",
      );
    } finally {
      setProcesando(false);
    }
  };

  if (cargando)
    return (
      <div className="min-h-screen flex justify-center items-center bg-slate-50">
        <div className="w-8 h-8 border-4 border-slate-200 border-t-slate-900 rounded-full animate-spin"></div>
      </div>
    );

  return (
    <div className="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8 font-sans">
      {/* ERROR GLOBAL UI */}
      {errorUI && (
        <div className="max-w-4xl mx-auto mb-6 bg-red-50 border border-red-200 p-4 rounded-xl flex items-center gap-3 animate-in fade-in">
          <svg
            className="w-6 h-6 text-red-600 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              strokeLinecap="round"
              strokeLinejoin="round"
              strokeWidth={2}
              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          <p className="text-sm font-bold text-red-800">{errorUI}</p>
        </div>
      )}

      {/* STEPPER EMPRESARIAL */}
      {paso < 4 && (
        <div className="max-w-5xl mx-auto mb-10">
          <div className="flex md:hidden items-center text-sm font-bold text-slate-500 mb-2">
            Paso {paso} de 3 <span className="mx-2">•</span>{" "}
            {paso === 1 ? "Plan" : paso === 2 ? "Transferencia" : "Comprobante"}
          </div>
          <div className="hidden md:flex items-center justify-center gap-4">
            {[
              "Selección de Plan",
              "Transferencia Bancaria",
              "Carga de Comprobante",
            ].map((title, i) => {
              const num = i + 1;
              const activo = paso >= num;
              return (
                <div key={num} className="flex items-center gap-4">
                  <div
                    className={`flex items-center gap-2 ${activo ? "text-slate-900" : "text-slate-400"}`}
                  >
                    <div
                      className={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-black ${activo ? "bg-slate-900 text-white" : "bg-slate-200"}`}
                    >
                      {num}
                    </div>
                    <span className="font-bold text-sm tracking-wide">
                      {title}
                    </span>
                  </div>
                  {num < 3 && (
                    <div
                      className={`w-12 h-px ${paso > num ? "bg-slate-900" : "bg-slate-200"}`}
                    ></div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* PASO 1: SELECCIÓN DE PLAN */}
      {paso === 1 && (
        <div className="max-w-5xl mx-auto animate-in fade-in duration-500">
          <div className="text-center mb-10">
            <h1 className="text-3xl md:text-4xl font-black text-slate-900 tracking-tight mb-3">
              Suscripción Clinesfera
            </h1>
            <p className="text-slate-500 font-medium">
              Infraestructura clínica y financiera para profesionales de la
              salud.
            </p>
          </div>

          <div className="flex justify-center mb-10">
            <div className="bg-slate-200/50 p-1 rounded-xl flex items-center gap-1">
              <button
                onClick={() => setFrecuencia("mensual")}
                className={`px-5 py-2 rounded-lg text-sm font-bold transition-all ${frecuencia === "mensual" ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700"}`}
              >
                Mensual
              </button>
              <button
                onClick={() => setFrecuencia("anual")}
                className={`px-5 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2 ${frecuencia === "anual" ? "bg-slate-900 text-white shadow-sm" : "text-slate-500 hover:text-slate-700"}`}
              >
                Anual{" "}
                <span className="bg-emerald-500/20 text-emerald-300 text-[10px] px-2 py-0.5 rounded-full uppercase tracking-widest">
                  Ahorra ~2 meses
                </span>
              </button>
            </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
            {planes.map((plan) => {
              const destacado = plan.nombre
                .toLowerCase()
                .includes("profesional");
              return (
                <div
                  key={plan.id}
                  className={`rounded-3xl p-8 border transition-all ${destacado ? "bg-slate-900 border-slate-800 shadow-2xl text-white md:-translate-y-2" : "bg-white border-slate-200 shadow-sm"}`}
                >
                  {destacado && (
                    <div className="inline-block bg-white text-slate-900 text-[10px] font-black uppercase tracking-widest py-1 px-3 rounded-full mb-6">
                      Recomendado
                    </div>
                  )}
                  <h3
                    className={`text-2xl font-black mb-1 ${destacado ? "text-white" : "text-slate-900"}`}
                  >
                    {plan.nombre}
                  </h3>
                  <p
                    className={`text-sm mb-6 ${destacado ? "text-slate-400" : "text-slate-500"}`}
                  >
                    {plan.descripcion}
                  </p>

                  <div className="mb-6">
                    <span className="text-4xl font-black">
                      $
                      {frecuencia === "mensual"
                        ? plan.precio_mensual
                        : plan.precio_anual}
                    </span>
                    <span
                      className={`text-sm font-bold ml-1 ${destacado ? "text-slate-400" : "text-slate-400"}`}
                    >
                      / {frecuencia}
                    </span>
                    <p
                      className={`text-[10px] mt-1 font-bold uppercase ${destacado ? "text-slate-500" : "text-slate-400"}`}
                    >
                      No incluye IVA
                    </p>
                  </div>

                  <ul className="space-y-3 mb-8">
                    {plan.caracteristicas.map((c, idx) => (
                      <li
                        key={idx}
                        className={`flex items-start gap-3 text-sm font-medium ${destacado ? "text-slate-300" : "text-slate-600"}`}
                      >
                        <svg
                          className={`w-5 h-5 shrink-0 ${destacado ? "text-emerald-400" : "text-slate-900"}`}
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            strokeLinecap="round"
                            strokeLinejoin="round"
                            strokeWidth={2}
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                        {c}
                      </li>
                    ))}
                  </ul>

                  <button
                    disabled={procesando}
                    onClick={() => procesarIntencionDePago(plan)}
                    className={`w-full py-3.5 px-6 font-black rounded-xl transition-all disabled:opacity-50 flex justify-center items-center gap-2 ${destacado ? "bg-white text-slate-900 hover:bg-slate-100" : "bg-slate-900 text-white hover:bg-slate-800"}`}
                  >
                    {procesando ? (
                      <div className="w-5 h-5 border-2 border-current border-t-transparent rounded-full animate-spin"></div>
                    ) : (
                      "Seleccionar Plan"
                    )}
                  </button>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* PASO 2 & 3: CHECKOUT SPLIT (Desktop) / STACK (Mobile) */}
      {(paso === 2 || paso === 3) && transaccion.desglose && datosBancarios && (
        <div className="max-w-6xl mx-auto flex flex-col-reverse lg:flex-row gap-8 animate-in slide-in-from-right-8 duration-500">
          {/* COLUMNA PRINCIPAL DE ACCIÓN */}
          <div className="flex-1 space-y-6">
            {/* TRUST CENTER */}
            <div className="bg-slate-100/50 border border-slate-200 rounded-2xl p-4 flex gap-4 text-sm text-slate-600">
              <svg
                className="w-5 h-5 shrink-0 text-slate-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2}
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                />
              </svg>
              <p>
                Clinesfera procesa los pagos en entornos controlados alineados a
                buenas prácticas de seguridad. Nunca solicitaremos credenciales
                de banca electrónica.
              </p>
            </div>

            {paso === 2 ? (
              /* ESTADO 2: TRANSFERENCIA */
              <div className="bg-white rounded-3xl p-6 md:p-8 border border-slate-200 shadow-sm">
                <h2 className="text-xl font-black text-slate-900 mb-6">
                  Datos de Transferencia
                </h2>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8 mb-8">
                  <div>
                    <p className="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
                      Entidad Bancaria
                    </p>
                    <p className="font-bold text-slate-900 text-lg">
                      {datosBancarios.banco}
                    </p>
                  </div>
                  <div>
                    <p className="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
                      Titular
                    </p>
                    <p className="font-bold text-slate-900 text-lg">
                      {datosBancarios.titular}
                    </p>
                  </div>
                  <div className="md:col-span-2 bg-slate-50 p-4 rounded-xl border border-slate-100 flex justify-between items-center">
                    <div>
                      <p className="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
                        Número de Cuenta ({datosBancarios.tipo_cuenta})
                      </p>
                      <p className="font-mono font-black text-xl md:text-2xl text-slate-900 tracking-widest">
                        {datosBancarios.numero_cuenta}
                      </p>
                    </div>
                    <button
                      onClick={() =>
                        copiarTexto(datosBancarios.numero_cuenta, "cta")
                      }
                      className="text-slate-600 hover:text-slate-900 font-bold text-sm bg-white border border-slate-200 px-4 py-2 rounded-lg shadow-sm"
                    >
                      {copiado === "cta" ? "Copiado ✓" : "Copiar"}
                    </button>
                  </div>
                  <div className="md:col-span-2 bg-indigo-50 border border-indigo-100 p-4 rounded-xl flex justify-between items-center">
                    <div>
                      <p className="text-xs font-bold text-indigo-400 uppercase tracking-wider mb-1">
                        Referencia (Concepto) Requerida
                      </p>
                      <p className="font-mono font-black text-lg text-indigo-900">
                        {transaccion.referencia}
                      </p>
                    </div>
                    <button
                      onClick={() =>
                        copiarTexto(transaccion.referencia!, "ref")
                      }
                      className="text-indigo-700 hover:text-indigo-900 font-bold text-sm bg-white border border-indigo-200 px-4 py-2 rounded-lg shadow-sm"
                    >
                      {copiado === "ref" ? "Copiado ✓" : "Copiar"}
                    </button>
                  </div>
                </div>

                <div className="border-t border-slate-100 pt-6">
                  <button
                    onClick={() => setPaso(3)}
                    className="w-full bg-slate-900 hover:bg-slate-800 text-white font-black py-4 rounded-xl shadow-md transition-colors text-lg"
                  >
                    Continuar a Carga de Comprobante →
                  </button>
                </div>
              </div>
            ) : (
              /* ESTADO 3: UPLOAD SEGURO */
              <div className="bg-white rounded-3xl p-6 md:p-8 border border-slate-200 shadow-sm animate-in slide-in-from-right-4 duration-300">
                <div className="flex justify-between items-center mb-6">
                  <h2 className="text-xl font-black text-slate-900">
                    Validación de Transferencia
                  </h2>
                  <button
                    onClick={() => setPaso(2)}
                    className="text-sm font-bold text-slate-500 hover:text-slate-900"
                  >
                    ← Volver a Datos
                  </button>
                </div>

                <div className="border-2 border-dashed border-slate-300 bg-slate-50 hover:bg-slate-100 transition-colors rounded-2xl p-8 mb-6 relative group flex flex-col items-center justify-center min-h-50">
                  <input
                    type="file"
                    accept=".pdf, .jpg, .jpeg, .png"
                    onChange={(e) =>
                      setArchivo(e.target.files ? e.target.files[0] : null)
                    }
                    className="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                  />
                  <svg
                    className="w-8 h-8 text-slate-400 mb-3 group-hover:text-slate-600 transition-colors"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      strokeWidth={2}
                      d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                    />
                  </svg>
                  {archivo ? (
                    <div className="text-center">
                      <p className="font-bold text-slate-900">
                        Comprobante seleccionado
                      </p>
                      <p className="text-xs font-bold text-emerald-600 mt-1">
                        ✓ {archivo.name.split(".").pop()?.toUpperCase()} •{" "}
                        {(archivo.size / 1024 / 1024).toFixed(2)} MB
                      </p>
                    </div>
                  ) : (
                    <div className="text-center">
                      <p className="font-bold text-slate-700">
                        Arrastra o haz clic para subir el comprobante
                      </p>
                      <p className="text-xs text-slate-500 mt-1">
                        Soporta PDF, JPG, PNG (Max. 5MB)
                      </p>
                    </div>
                  )}
                </div>

                <button
                  onClick={procesarComprobante}
                  disabled={!archivo || procesando}
                  className="w-full bg-slate-900 hover:bg-slate-800 text-white font-black py-4 rounded-xl shadow-md transition-all disabled:opacity-50 flex items-center justify-center gap-2"
                >
                  {procesando ? (
                    <>
                      <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>{" "}
                      Validando archivo...
                    </>
                  ) : (
                    "Enviar a Revisión Administrativa"
                  )}
                </button>
              </div>
            )}
          </div>

          {/* COLUMNA LATERAL: RESUMEN */}
          <div className="lg:w-80 shrink-0">
            <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm sticky top-6">
              <h3 className="font-black text-slate-900 mb-4 text-sm uppercase tracking-widest">
                Resumen de Cargo
              </h3>

              <div className="space-y-3 mb-6">
                <div className="flex justify-between items-center text-sm">
                  <span className="text-slate-500 font-medium">Plan</span>
                  <span className="font-bold text-slate-900">
                    {transaccion.plan?.nombre}
                  </span>
                </div>
                <div className="flex justify-between items-center text-sm">
                  <span className="text-slate-500 font-medium">Ciclo</span>
                  <span className="font-bold text-slate-900 capitalize">
                    {frecuencia}
                  </span>
                </div>
                <div className="flex justify-between items-center text-sm">
                  <span className="text-slate-500 font-medium">Subtotal</span>
                  <span className="font-bold text-slate-900">
                    ${transaccion.desglose.subtotal.toFixed(2)}
                  </span>
                </div>
                <div className="flex justify-between items-center text-sm border-b border-slate-100 pb-3">
                  <span className="text-slate-500 font-medium">
                    Impuestos (15%)
                  </span>
                  <span className="font-bold text-slate-900">
                    ${transaccion.desglose.impuestos.toFixed(2)}
                  </span>
                </div>
              </div>

              <div className="flex justify-between items-center mb-6">
                <span className="font-black text-slate-900">Total</span>
                <span className="text-2xl font-black text-slate-900">
                  ${transaccion.desglose.total.toFixed(2)}
                </span>
              </div>

              <div className="bg-slate-50 rounded-xl p-3 border border-slate-100">
                <p className="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">
                  Referencia Asignada
                </p>
                <p className="font-mono text-sm font-black text-slate-900">
                  {transaccion.referencia}
                </p>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* PASO 4: ÉXITO SEGURO */}
      {paso === 4 && (
        <div className="max-w-2xl mx-auto animate-in slide-in-from-bottom-8 duration-700">
          <div className="bg-white rounded-3xl p-8 md:p-12 border border-slate-200 shadow-sm text-center">
            <div className="w-20 h-20 bg-slate-50 text-slate-900 rounded-full flex items-center justify-center mx-auto mb-6 border border-slate-100">
              <svg
                className="w-8 h-8"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2.5}
                  d="M5 13l4 4L19 7"
                />
              </svg>
            </div>

            <h2 className="text-2xl font-black text-slate-900 mb-3">
              Comprobante recibido correctamente
            </h2>
            <p className="text-slate-500 font-medium mb-8">
              Tu archivo fue registrado de forma segura. El área administrativa
              validará la transacción en las próximas horas.
            </p>

            <div className="bg-slate-50 border border-slate-100 rounded-2xl p-6 text-left mb-8 max-w-sm mx-auto">
              <div className="flex justify-between items-center mb-3">
                <span className="text-slate-500 font-bold text-sm">
                  Estado Actual:
                </span>
                <span className="bg-amber-100 text-amber-700 px-3 py-1 rounded-md text-xs font-black uppercase tracking-widest flex items-center gap-1.5">
                  <span className="w-1.5 h-1.5 bg-amber-500 rounded-full animate-pulse"></span>{" "}
                  En Revisión
                </span>
              </div>
              <div className="flex justify-between items-center">
                <span className="text-slate-500 font-bold text-sm">
                  ID Operación:
                </span>
                <span className="font-mono font-bold text-slate-900 text-sm">
                  {transaccion.referencia}
                </span>
              </div>
            </div>

            <button
              onClick={() => router.push("/dashboard-psicologo")}
              className="bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 px-8 rounded-xl transition-colors shadow-sm"
            >
              Volver a mi Panel
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

